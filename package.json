{
  "name": "archivo-riftbound",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo de cartas Riftbound para compartir: copias por idioma y acabado, repetidas y precios de Cardmarket.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "sync": "node scripts/sync-cards.js",
    "import": "node --env-file-if-exists=.env scripts/import-collection.js",
    "check": "node scripts/check.js && node scripts/check-save.js",
    "build": "node scripts/build-static.js",
    "fingerprints": "node scripts/fingerprints.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1"
  }
}
