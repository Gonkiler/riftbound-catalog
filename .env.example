# Copia este archivo como .env y rellena los valores.

# Contraseña del modo administrador. Sin ella, la web es de solo lectura.
ADMIN_PASSWORD=

# Clave para firmar la cookie de sesión. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Puerto del servidor.
PORT=3000

# Dónde se guarda la colección (SQLite).
DB_PATH=data/coleccion.db

# Cada cuántas horas se vuelve a descargar la guía de precios de Cardmarket.
PRICE_TTL_HOURS=12

# Pon 1 si la web va detrás de un proxy con HTTPS (Render, Railway, Fly...).
TRUST_PROXY=0
