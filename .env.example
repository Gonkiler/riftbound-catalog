# Copia este archivo como .env y rellena los valores.

# Contraseña para editar la colección. Sin ella, la web es de solo lectura.
ADMIN_PASSWORD=

# Clave para firmar la cookie de sesión. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Tu nombre: la web dirá "Colección de <nombre>" y así saldrá al compartir el enlace.
OWNER_NAME=

# Base de datos en la nube (Turso). Déjalo vacío para usar el archivo local DB_PATH.
# Los da `turso db show --url <base>` y `turso db tokens create <base>`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Archivo SQLite local (solo si no hay TURSO_DATABASE_URL).
DB_PATH=data/coleccion.db

# Puerto del servidor.
PORT=3000

# Cada cuántas horas se vuelve a descargar la guía de precios de Cardmarket.
PRICE_TTL_HOURS=12

# Pon 1 si la web va detrás de un proxy con HTTPS (en Render se detecta solo).
TRUST_PROXY=0
